# MySQL database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=siif

# Photo token signing secret (used to sign admin photo proxy URLs)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHOTO_TOKEN_SECRET=replace_with_a_random_64_char_hex_string

# Local photo storage; mount a persistent writable volume at this path in production.
# Photos are written under UPLOAD_DIR/incubatee-photos.
UPLOAD_DIR=uploads

# SMTP settings are required only for password recovery emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Payment Gateway (Razorpay — swap with SBIePay credentials when available)
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# App URL (used for payment return/webhook URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
